# Apple Reminders リスト名
STOCK_LIST_NAME=ストック
FLOW_LIST_NAME=フロー

# Google Calendar OAuth2 クライアント情報
# Google Cloud Console から credentials.json をダウンロードして配置
# 初回認証: python setup_google_auth.py husband / wife

# タイムゾーン
TIMEZONE=Asia/Tokyo

# 共有ファミリーカレンダーID（夫アカウントの calendarList に出ない場合に明示追加）
# 空欄ならファミリーカレンダーの追加取得をスキップ
FAMILY_CALENDAR_ID=
# 取得対象から除外するカレンダーID（カンマ区切り）
# 例: freeBusyReader 権限しか無く 403 でログが汚れるアカウント
EXCLUDED_CALENDAR_IDS=

# サーバー設定
PORT=8080

# API認証トークン（空欄の場合は認証無効）
API_TOKEN=

# ログレベル (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 学校配布物スキャン機能（Gemini APIキー）
# Google AI Studio (https://aistudio.google.com/) で取得
# 空欄の場合はスキャン機能が動作しない
GEMINI_API_KEY=

# 子供の名前（カンマ区切り）- 学校配布物スキャン機能で使用
CHILDREN=紗奈,和花,舞

# Google Home 音声ブリーフィング（Cast で再生、macOS の say で音声合成）
# Google Home アプリに表示されるスピーカー名（例: リビング）。空欄なら無効
GOOGLE_HOME_NAME=
# 毎朝の自動再生時刻（HH:MM）。空欄なら自動再生しない
BRIEFING_CAST_TIME=07:00
# 読み上げ音声（say -v '?' で一覧）
TTS_VOICE=Kyoko
# 再生音量 0.0〜1.0（負値なら現在の音量のまま）
GOOGLE_HOME_VOLUME=-1
# Google Home から見たこのサーバーのURL。空欄なら LAN IP を自動検出
PUBLIC_BASE_URL=
